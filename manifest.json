{
  "manifest_version": 3,
  "name": "Arcify",
  "version": "0.7.6",
  "description": "Arc-style persistent pinned tabs for Chrome",
  "permissions": [
    "tabs",
    "storage",
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "switch-last-tab": {
      "suggested_key": {
        "mac": "MacCtrl+Period"
      },
      "description": "Switch to last visited tab"
    }
  },
  "action": {
    "default_title": "Arcify",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "32": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon128.png",
    "32": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "incognito": "not_allowed"
}
